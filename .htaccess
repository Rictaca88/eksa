# Set PHP 8.2
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(.*)$ public/$1 [L]

RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://www.eksacomercial.cl/$1 [R,L]

</IfModule>

RewriteCond %{HTTP_REFERER} !^http://eksacomercial.cl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://eksacomercial.cl$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.eksacomercial.cl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.eksacomercial.cl$      [NC]
RewriteCond %{HTTP_REFERER} !^https://eksacomercial.cl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://eksacomercial.cl$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.eksacomercial.cl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.eksacomercial.cl$      [NC]
RewriteRule .*\.(jpg|jpeg|gif|png|bmp)$ - [F,NC]
